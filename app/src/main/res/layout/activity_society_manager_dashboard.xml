<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/drawer_layout" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F5F7F6">
    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent">
        <!--  Top bar  -->
        <LinearLayout android:id="@+id/topBar" android:layout_width="match_parent" android:layout_height="64dp" android:background="#5C8374" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp" app:layout_constraintTop_toTopOf="parent">
            <ImageView android:id="@+id/btnMenu" android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_sort_by_size" android:background="?attr/selectableItemBackgroundBorderless" app:tint="#FFFFFF"/>
            <TextView android:id="@+id/tvWelcomeUser" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:text="Welcome, Manager" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"/>
            <ImageView android:id="@+id/btnLogout" android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_lock_power_off" android:background="?attr/selectableItemBackgroundBorderless" app:tint="#FFFFFF"/>
        </LinearLayout>
        <!--  Dashboard scrollable body  -->
        <androidx.core.widget.NestedScrollView android:id="@+id/dashboardContent" android:layout_width="match_parent" android:layout_height="0dp" android:clipToPadding="false" android:paddingBottom="32dp" app:layout_constraintTop_toBottomOf="@id/topBar" app:layout_constraintBottom_toTopOf="@id/bottomNav">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <!--  Society hero header  -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#5C8374" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="16dp" android:paddingBottom="24dp">
                    <TextView android:id="@+id/tvSocietyName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Society" android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/tvSocietySubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Manager Dashboard" android:textColor="#D0E8E0" android:textSize="13sp"/>
                    <!--  Stats strip  -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="#4A7264" android:padding="14dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                            <TextView android:id="@+id/tvStatMembers" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Members" android:textColor="#D0E8E0" android:textSize="11sp"/>
                        </LinearLayout>
                        <View android:layout_width="1dp" android:layout_height="36dp" android:background="#6EA898"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                            <TextView android:id="@+id/tvStatEvents" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Events" android:textColor="#D0E8E0" android:textSize="11sp"/>
                        </LinearLayout>
                        <View android:layout_width="1dp" android:layout_height="36dp" android:background="#6EA898"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                            <TextView android:id="@+id/tvStatTasks" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tasks" android:textColor="#D0E8E0" android:textSize="11sp"/>
                        </LinearLayout>
                        <View android:layout_width="1dp" android:layout_height="36dp" android:background="#6EA898"/>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                            <TextView android:id="@+id/tvStatAnnouncements" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Notices" android:textColor="#D0E8E0" android:textSize="11sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <!--  Content cards  -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <!--  Upcoming Events  -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Upcoming Events" android:textSize="16sp" android:textStyle="bold" android:textColor="#1A1A2E"/>
                        <TextView android:id="@+id/tvViewAllEvents" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="See all" android:textColor="#5C8374" android:textSize="13sp" android:textStyle="bold" android:background="?attr/selectableItemBackgroundBorderless" android:padding="4dp"/>
                    </LinearLayout>
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvEvents" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="24dp" android:nestedScrollingEnabled="false"/>
                    <!--  Pending Requests  -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Pending Requests" android:textSize="16sp" android:textStyle="bold" android:textColor="#1A1A2E"/>
                        <TextView android:id="@+id/tvViewAllMembers" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="See all" android:textColor="#5C8374" android:textSize="13sp" android:textStyle="bold" android:background="?attr/selectableItemBackgroundBorderless" android:padding="4dp"/>
                    </LinearLayout>
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvMembers" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <!--  Fragment container  -->
        <FrameLayout android:id="@+id/fragmentContainer" android:layout_width="match_parent" android:layout_height="0dp" android:elevation="5dp" android:visibility="gone" app:layout_constraintTop_toBottomOf="@id/topBar" app:layout_constraintBottom_toTopOf="@id/bottomNav"/>
        <!--  Bottom navigation — each icon and label has its own ID  -->
        <LinearLayout android:id="@+id/bottomNav" android:layout_width="match_parent" android:layout_height="68dp" android:background="#FFFFFF" android:elevation="12dp" android:gravity="center" android:orientation="horizontal" app:layout_constraintBottom_toBottomOf="parent">
            <!--  HOME  -->
            <LinearLayout android:id="@+id/navHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:background="?attr/selectableItemBackgroundBorderless">
                <ImageView android:id="@+id/iconHome" android:layout_width="22dp" android:layout_height="22dp" android:src="@android:drawable/ic_menu_myplaces"/>
                <TextView android:id="@+id/labelHome" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HOME" android:textSize="9sp" android:layout_marginTop="3dp"/>
            </LinearLayout>
            <!--  MEMBERS  -->
            <LinearLayout android:id="@+id/navMembers" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:background="?attr/selectableItemBackgroundBorderless">
                <ImageView android:id="@+id/iconMembers" android:layout_width="22dp" android:layout_height="22dp" android:src="@android:drawable/ic_menu_share"/>
                <TextView android:id="@+id/labelMembers" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MEMBERS" android:textSize="9sp" android:layout_marginTop="3dp"/>
            </LinearLayout>
            <!--  EVENTS  -->
            <LinearLayout android:id="@+id/navEvents" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:background="?attr/selectableItemBackgroundBorderless">
                <ImageView android:id="@+id/iconEvents" android:layout_width="22dp" android:layout_height="22dp" android:src="@android:drawable/ic_menu_today"/>
                <TextView android:id="@+id/labelEvents" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EVENTS" android:textSize="9sp" android:layout_marginTop="3dp"/>
            </LinearLayout>
            <!--  TASKS  -->
            <LinearLayout android:id="@+id/navTasks" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:background="?attr/selectableItemBackgroundBorderless">
                <ImageView android:id="@+id/iconTasks" android:layout_width="22dp" android:layout_height="22dp" android:src="@android:drawable/ic_menu_agenda"/>
                <TextView android:id="@+id/labelTasks" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TASKS" android:textSize="9sp" android:layout_marginTop="3dp"/>
            </LinearLayout>
            <!--  NOTICES  -->
            <LinearLayout android:id="@+id/navAnnouncements" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:background="?attr/selectableItemBackgroundBorderless">
                <ImageView android:id="@+id/iconAnnouncements" android:layout_width="22dp" android:layout_height="22dp" android:src="@android:drawable/ic_popup_reminder"/>
                <TextView android:id="@+id/labelAnnouncements" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NOTICES" android:textSize="9sp" android:layout_marginTop="3dp"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <!--  Drawer  -->
    <com.google.android.material.navigation.NavigationView android:id="@+id/nav_view" android:layout_width="280dp" android:layout_height="match_parent" android:layout_gravity="start" android:fitsSystemWindows="true" app:headerLayout="@layout/nav_header_society" app:menu="@menu/drawer_menu_society"/>
</androidx.drawerlayout.widget.DrawerLayout>